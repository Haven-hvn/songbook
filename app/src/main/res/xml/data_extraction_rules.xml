<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device.

  Local state is a wallet address, per-identity databases (the mirror, and playlists, history
  and follows), the content cache and staged files. None of it rides a cloud backup or a
  device-to-device transfer: the cache is keyed to a wallet that may not be on the other
  device, and play history is never to leave this one (docs/PLAN.md §2).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
